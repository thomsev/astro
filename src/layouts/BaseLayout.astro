---
import '../styles/global.css';
import { cssVars } from '../theme/cssVars';

const { title = 'Astro WP Blog' } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style is:global>{cssVars}</style>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">Astro WP Blog</a>
        <nav>
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style is:global>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    gap: var(--space-lg);
  }

  .brand {
    font-weight: 700;
    font-size: var(--font-size-lg);
  }

  nav {
    display: flex;
    gap: var(--space-md);
    font-size: var(--font-size-sm);
  }
</style>
