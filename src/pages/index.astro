---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Astro + WordPress Blog">
  <section class="stack">
    <h1 class="section-heading">Astro + WordPress starter</h1>
    <p>
      This project connects Astro to a local WordPress instance via the REST API and
      renders blog posts with shared design tokens.
    </p>
    <a class="notice" href="/blog">Visit the blog</a>
  </section>
</BaseLayout>
